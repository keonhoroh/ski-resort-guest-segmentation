# Copy to .env and fill in. .env is gitignored; never commit real secrets.
# Both docker compose and Rails (via dotenv-rails) read .env.

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=liftline
CLICKHOUSE_USER=liftline
CLICKHOUSE_PASSWORD=change-me

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=liftline
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://localhost:6379/0

# Seconds SendCampaignJob pauses per batch of 1,000 guests, so progress is visible.
CAMPAIGN_SEND_DELAY=0.2
